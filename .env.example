# ---- Supabase (required) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. NEVER prefix with NEXT_PUBLIC_ and never import from client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=change-me-long-random-string
# Pepper used when hashing guest manage tokens and API keys
TOKEN_PEPPER=change-me-another-long-random-string

# ---- Email (Resend) — optional; leave blank and email is logged as not_configured ----
RESEND_API_KEY=
EMAIL_FROM="T23 Reservations <reservations@your-domain.com>"

# ---- SMS (Twilio) — optional ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- LINE Messaging API — optional ----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ---- WhatsApp Cloud API — optional ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Payments — optional ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OMISE_SECRET_KEY=

# ---- FoodStory POS — pending vendor API access ----
FOODSTORY_API_BASE_URL=
FOODSTORY_API_KEY=
